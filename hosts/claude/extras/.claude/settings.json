{
  "enabledMcpjsonServers": ["literature"],
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(python:*)",
      "Bash(uv run:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "mcp__literature"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "huggingface.co",
        "*.huggingface.co",
        "hf.co",
        "*.hf.co",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
